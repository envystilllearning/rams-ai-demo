# ============================================================
# RAMS AI Demo — Environment Variables (PRD §34)
# Copy to .env (frontend) / backend/.env (backend) and fill values.
# NEVER commit real .env files.
# ============================================================

# ---------------- Frontend (Next.js) ----------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# ---------------- Backend (FastAPI) ----------------
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Secret used to verify Supabase JWTs server-side
# (Supabase Dashboard > Project Settings > API > JWT Settings)
SUPABASE_JWT_SECRET=

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=

OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini

APP_ENV=development
FRONTEND_URL=http://localhost:3000
BACKEND_CORS_ORIGINS=http://localhost:3000

# Subscription access policy (PRD §4): past_due allowed = configurable
SUBSCRIPTION_ALLOW_PAST_DUE=false

# ---------------- Document worker (Gotenberg) ----------------
# DOCX -> PDF conversion service running in Docker (PRD §13).
# docker-compose maps host port 3100 -> container port 3000.
GOTENBERG_URL=http://localhost:3100

# ---------------- Optional (P2, not required for MVP) ----------------
# RESEND_API_KEY=
